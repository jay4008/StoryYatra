PORT=4100
NODE_ENV=production
DATABASE_URL=postgresql://storyyatra:CHANGE_ME@localhost:5432/storyyatra

# Google Cloud Console ke OAuth Client IDs (comma se alag). Web wala zaroor daalna.
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com

# Apple Sign In: iOS bundle id (jaise com.storyyatra.app) aur Services ID (Android ke liye), comma se
APPLE_CLIENT_IDS=com.storyYatra

# Apna JWT sign karne ki key: `openssl rand -base64 48` se banao
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_DAYS=365

# Default 127.0.0.1 (VPS: nginx ke peeche). Local dev mein real phone ke liye 0.0.0.0
HOST=127.0.0.1

# Story ids aur part counts yahan ke catalog.json se check hote hain
CDN_BASE=https://cdn.technoplatsolution.online/

# App/website ke origins (comma se alag). Mobile app ke liye zaroori nahi.
CORS_ORIGINS=
